OCR_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
TTS_MAX_TEXT_LENGTH=4000
TTS_MIN_SPEED=0.5
TTS_MAX_SPEED=2
